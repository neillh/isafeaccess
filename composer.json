{
	"name": "mavero/sfa",
	"description": "SFA WordPress Theme",
	"type": "wordpress-theme",
	"config": {
		"sort-packages": true,
		"process-timeout": 600,
		"preferred-install": "dist",
		"vendor-dir": "plugins/vendor",
		"platform": {
			"php": "8.4"
		},
		"allow-plugins": {
			"johnpbloch/wordpress-core-installer": true,
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"ffraenz/private-composer-installer": true,
			"php-http/discovery": true
		}
	},
	"require": {
		"composer/installers": "^2.0",
		"johnbillion/extended-cpts": "^5.0",
		"wpackagist-plugin/google-site-kit": "^1.188.0",
		"wpackagist-plugin/twentig": "^2.0.5",
		"wpackagist-plugin/jetpack": "^16.2",
		"wpackagist-plugin/wordpress-seo": "^28.5",
		"wpackagist-plugin/simple-history": "^5.34.0",
		"wpackagist-plugin/simple-cloudflare-turnstile": "^1.43.2",
		"wpackagist-plugin/microsoft-clarity": "^0.10.33",
		"wpackagist-plugin/reusable-blocks-extended": "^0.9.1"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^6.9",
		"squizlabs/php_codesniffer": "^3.7",
		"wp-coding-standards/wpcs": "^2.3"
	},
	"extra": {
		"wordpress-install-dir": "../",
		"installer-paths": {
			"mu-plugins/{$name}": [
				"type:wordpress-muplugin",
				"wpackagist-plugin/query-monitor"
			],
			"plugins/{$name}/": [
				"type:wordpress-plugin"
			]
		},
		"installer-exclude": [
			"wpforms"
		]
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org",
			"only": [
				"wpackagist-plugin/*"
			]
		}
	],
	"scripts": {
		"phpcs": "phpcs --standard=WordPress",
		"phpcbf": "phpcbf --standard=WordPress"
	}
}
